{
  "model": "mock-lipsync",
  "prompt": "optional",
  "limits": {
    "prompt_max_chars": 200
  },
  "inputs": [
    {
      "name": "source_video",
      "label": "Source video",
      "required": true,
      "kind": "video",
      "mime": [
        "video/mp4",
        "video/webm"
      ],
      "max_bytes": 104857600,
      "max_seconds": 30
    },
    {
      "name": "audio",
      "label": "Audio to sync to",
      "required": true,
      "kind": "audio",
      "mime": [
        "audio/mpeg",
        "audio/wav",
        "audio/x-wav"
      ],
      "max_bytes": 20971520,
      "max_seconds": 30
    }
  ],
  "params": []
}
