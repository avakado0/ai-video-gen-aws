{
  "model": "wan2-2-ti2v-5b",
  "prompt": "required",
  "limits": {
    "prompt_max_chars": 500
  },
  "inputs": [
    {
      "name": "image",
      "label": "Starting image (optional)",
      "kind": "image",
      "required": false,
      "max_files": 1,
      "mime": ["image/png", "image/jpeg"],
      "max_bytes": 10485760
    }
  ],
  "params": [
    {
      "name": "seed",
      "type": "int",
      "min": 0,
      "max": 2147483647
    },
    {
      "name": "duration_seconds",
      "type": "enum",
      "default": "3",
      "values": ["3", "5"]
    },
    {
      "name": "quality",
      "type": "enum",
      "default": "fast",
      "values": ["fast", "high"]
    },
    {
      "name": "negative_prompt",
      "type": "string",
      "default": "",
      "max_chars": 200
    }
  ]
}
